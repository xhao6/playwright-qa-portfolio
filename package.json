{
  "name": "playwright-qa-portfolio",
  "version": "0.1.0",
  "description": "Playwright + TypeScript automated test portfolio against a private EspoCRM instance",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --grep @ui",
    "test:api": "playwright test --grep @api",
    "test:report": "playwright show-report",
    "test:trace": "playwright show-trace"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
